{
  "name": "venera-runtime",
  "version": "0.1.0",
  "description": "A venera runtime that works in both Node and JSBox environments.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/api-test-suite.*",
    "!dist/compare-test-reports.*",
    "!dist/jsbox-test-runner.*",
    "!dist/node-test-runner.*",
    "!dist/show-input-dialog.*",
    "!dist/show-loading.*",
    "docs",
    "README.md",
    "LICENSE",
    "examples",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/jsbox": {
      "types": "./dist/adapters/jsbox.d.ts",
      "default": "./dist/adapters/jsbox.js"
    }
  },
  "engines": {
    "node": "^20.18.1 || ^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:node-report": "tsc && node dist/node-test-runner.js",
    "test:compare": "tsc && node dist/compare-test-reports.js",
    "build:node": "npm run clean && tsc",
    "build": "node scripts/build-jsbox.cjs",
    "build:debug": "node scripts/build-jsbox.cjs --debug",
    "build:jsbox-test": "node scripts/build-jsbox.cjs --entry ./dist/jsbox-test-runner.js",
    "build:jsbox-test:debug": "node scripts/build-jsbox.cjs --debug --entry ./dist/jsbox-test-runner.js",
    "prepare": "npm run build:node",
    "format": "prettier --write .",
    "test:compat": "vitest run --config vitest.compat.config.mts",
    "clean": "node scripts/clean.cjs",
    "test:package": "npm run build:node && node scripts/test-package.cjs",
    "test:examples": "npm run build:node && tsc -p examples/tsconfig.node.json && tsc -p examples/tsconfig.jsbox.json && node scripts/test-examples.cjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:examples && npm run test:package",
    "check:release": "npm run check && npm run test:compat && npm run build:jsbox-test && npm audit",
    "prepublishOnly": "npm run check:release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gandum2077/venera-runtime.git"
  },
  "keywords": [
    "venera",
    "jsbox",
    "comic"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Gandum2077/venera-runtime/issues"
  },
  "homepage": "https://github.com/Gandum2077/venera-runtime#readme",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "clipboardy": "^5.3.1",
    "crypto-js": "^4.2.0",
    "domhandler": "^5.0.3",
    "iconv-lite": "^0.7.3",
    "jsbox-cview": "^1.6.9",
    "sharp": "^0.35.4",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.1.1",
    "@types/url-parse": "^1.4.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsbox-types": "^2.0.3",
    "minimizer-webpack-plugin": "^5.6.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
